# Copy to .env and fill in your values

# Security
SECRET_KEY=change-me-to-a-long-random-string

# Slack Integration (optional)
# Option A: Incoming Webhook (simplest)
SLACK_DEFAULT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Option B: Bot Token (richer messages via chat.postMessage)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Microsoft Teams Integration (optional)
# Incoming Webhook URL from Teams connector
TEAMS_DEFAULT_WEBHOOK_URL=https://your-org.webhook.office.com/...

# ntfy (optional — for forwarding to ntfy)
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOKEN=

# Debug
DEBUG=false
