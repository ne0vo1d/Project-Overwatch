# Application
APP_NAME="Project Overwatch"
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# Database
DATABASE_URL=postgresql+asyncpg://overwatch:overwatch@db:5432/overwatch

# Redis
REDIS_URL=redis://redis:6379/0

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]

# Slack (optional — configure in UI or set defaults here)
SLACK_DEFAULT_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Microsoft Teams (optional)
TEAMS_DEFAULT_WEBHOOK_URL=

# ntfy (optional)
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOKEN=

# SendGrid
SENDGRID_API_KEY=SG.your-api-key
SENDGRID_FROM_EMAIL=alerts@yourdomain.com
SENDGRID_FROM_NAME=Project Overwatch

# Ingest webhook secret (optional, protects /ingest/generic)
INGEST_SECRET=
